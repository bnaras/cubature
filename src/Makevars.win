CUBATURE_DIR=libcubature
CUBA_DIR=Cuba
CUBA_DIR_WIN=Cuba-win

R_CPPFLAGS := $(shell $(R_HOME)/bin/R CMD config --cppflags)
PKG_CPPFLAGS=-I. -I../inst/include -I../../inst/include -I./src/common -D_R_INTERFACE $(R_CPPFLAGS)
PKG_LIBS=-L./$(CUBATURE_DIR) -L./$(CUBA_DIR) -lcubature -lcuba

CUBATURE_SOURCES=$(wildcard $(CUBATURE_DIR)/*.c $(CUBATURE_DIR)/*.h)
CUBA_SOURCES=$(wildcard $(CUBA_DIR)/src/*/*.c $(CUBA_DIR)/src/*/*.h $(CUBA_DIR)/src/common/*.c $(CUBA_DIR)/*.h)

CUBATURE_LIB=$(CUBATURE_DIR)/libcubature.a
CUBA_LIB=$(CUBA_DIR)/libcuba.a

$(SHLIB): Rcpp-cubature.o Rcpp-Cuba.o RcppExports.o cubature_init.o

Rcpp-cubature.o: $(CUBATURE_LIB)
RcppExports.o:   $(CUBATURE_LIB) $(CUBA_LIB)
Rcpp-Cuba.o:     $(CUBA_LIB)

$(CUBATURE_LIB): $(CUBATURE_SOURCES)
	cd $(CUBATURE_DIR) && $(MAKE) libcubature.a \
	  CC=$(CC) \
	  CFLAGS="$(CPPFLAGS) $(PKG_CPPFLAGS) $(CPICFLAGS) -DNOSHORTS" \
	  AR=$(AR) RANLIB=$(RANLIB)

$(CUBA_LIB): $(CUBA_SOURCES)
	cp $(CUBA_DIR_WIN)/config.h $(CUBA_DIR)/config.h
	cp $(CUBA_DIR_WIN)/Makefile $(CUBA_DIR)/Makefile
	cd $(CUBA_DIR) && $(MAKE) lib \
	  CC=$(CC) \
	  CFLAGS="$(CPPFLAGS) $(PKG_CPPFLAGS) -UHAVE_FORK -DHAVE_CONFIG_H -DREALSIZE=8 $(CPICFLAGS)" \
	  AR=$(AR) RANLIB=$(RANLIB)

clean:
	rm -f Rcpp-cubature.o RcppExports.o cubature.so Rcpp-Cuba.o cubature_init.o
	rm -f $(CUBATURE_DIR)/*.o $(CUBATURE_LIB)
	rm -f $(CUBA_DIR)/*.o $(CUBA_LIB)
